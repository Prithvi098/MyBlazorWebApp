@page "/user-rights"
@attribute [Authorize]
@layout MainLayout
@inject IDbContextFactory<EMSContext> DbFactory
@using MyBlazorApp.Common
@inject AppToastService ToastService
@inject MenuService MenuService
@rendermode InteractiveServer

<PageTitle>User Rights</PageTitle>


<section class="content inner-tbl pt-5 pb-3 page-section">
    <div class="container-fluid">
        <EditForm EditContext="@editContext" OnValidSubmit="SaveUserRights">
            <div class="row">
                <FluentValidationValidator />
                <div class="col-12 col-lg-5">
                    <div class="card content-surface-card">
                        <div class="content-header">
                            <div class="container-fluid">
                                <div class="row align-items-center">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="main-title text-lg-left">
                                            <h2>User Rights</h2>
                                        </div>
                                    </div>

                                    
                                </div>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="row">
                                <div class="col-12">
                                    <div class="input-group cus-select mb-2">
                                        <label class="form-label" for="exampleFormControlSelect1">User List</label>
                                        <InputSelect class="form-control" @bind-Value="EmpId">
                                            <option value="0">-- Select User --</option>
                                            @foreach (var employee in EmployeeList)
                                            {
                                                <option value="@employee.Value">@employee.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <ValidationMessage For="@(() => UserRight.EmpId)" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <CopyUserRightsForm EmployeeList="EmployeeList" />
                </div>
                <div class="col-12 col-lg-7">
                    <div class="card content-surface-card">
                        <div class="content-header">
                            <div class="container-fluid">
                                <div class="row align-items-center">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="main-title text-lg-left">
                                            <h2>User Rights Menu List</h2>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6 col-lg-6 text-lg-right d-flex justify-content-lg-end gap-2 flex-wrap">
                                        <button class="btn btn-secondary" id="btnClear" type="button">Clear</button>
                                        <RadzenButton Text="Save" Icon="save" id="btnSaveUserRight" ButtonType="Radzen.ButtonType.Submit" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card-body user-rights-menu">
                            <ValidationMessage For="@(() => UserRight.UserRights)" />
                            @if (UserRightsList.Count > 0)
                            {
                                <div class="row" id="selectallhide" >
                                    <div class="col-12">
                                        <input type="checkbox" id="selectall" checked="@IsAllSelected" @onchange="(e) => ToggleSelectAll((bool)((ChangeEventArgs)e).Value!)">
                                        <label for="selectall" class="custom-unchecked">Select All</label>
                                    </div>
                                </div>
                                <ul id="menuTree" class="treeview">
                                    
                                    @foreach (var parent in UserRightsList)
                                    {
                                        <li>
                                            <input type="checkbox" checked="@parent.IsChecked" id="menu_@parent.MID" @onchange="(e) => ToggleMenu(parent, (bool)((ChangeEventArgs)e).Value!)" />
                                            <label class="custom-unchecked fw-bold" for="menu_@parent.MID">@parent.MenuName</label>
                                            <ul>
                                                @if (parent.SubMenus.Count > 0)
                                                {
                                                    foreach (var submenu in parent.SubMenus)
                                                    {
                                                        <li>
                                                            <input type="checkbox" checked="@submenu.IsChecked" id="menu_@submenu.MID" @onchange="(e) => ToggleSubMenu(parent, submenu, (bool)((ChangeEventArgs)e).Value!, fromParent: true)" />
                                                            <label class="custom-unchecked fw-bold" for="menu_@submenu.MID">@submenu.MenuName</label>
                                                            <ul>
                                                                <li>
                                                                    @if (submenu.Rights != null)
                                                                    {
                                                                        @foreach (var right in submenu.Rights)
                                                                        {
                                                                            <input type="checkbox" checked="@right.IsChecked" id="menu_Ur_@(submenu.MID + "_" + right.rights.RID)" @onchange="(e) => ToggleRight(submenu, right, (bool)((ChangeEventArgs)e).Value!)" />
                                                                            <label class="custom-unchecked fw-bold" for="menu_Ur_@(submenu.MID + "_" + right.rights.RID)">@right.rights.RightsName &nbsp;&nbsp;</label>
                                                                        }
                                                                    }
                                                                </li>
                                                            </ul>
                                                        </li>
                                                    }
                                                }
                                                else
                                                {
                                                   <li>
                                                        @if (parent.Rights != null)
                                                        {
                                                            @foreach (var right in parent.Rights)
                                                            {
                                                                <input type="checkbox" checked="@right.IsChecked" id="menu_Ur_@(parent.MID + "_" + right.rights.RID)" @onchange="(e) => ToggleRight(parent, right, (bool)((ChangeEventArgs)e).Value!)" />
                                                                <label class="custom-unchecked fw-bold" for="menu_Ur_@(parent.MID + "_" + right.rights.RID)">@right.rights.RightsName</label>
                                                            }
                                                        }
                                                   </li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                    
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>

</section>


@code {
    private List<SelectListItem> EmployeeList = new();
    private UserRightsModel UserRight = new UserRightsModel();
    private List<MenuModel> UserRightsList = new List<MenuModel>();
    private EditContext editContext;

    private bool IsAllSelected = false;
    private int _empId;
    public int EmpId
    {
        get => _empId;
        set
        {
            if (_empId != value)
            {
                _empId = value;
                _ = GetUserRightsDetails(); // call async method without blocking
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(UserRight);
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        try
        {
            using var dbContext = await DbFactory.CreateDbContextAsync();
            var employees = await dbContext.Mst_Employees
                .Select(e => new SelectListItem
                {
                    Value = e.Emp_id.ToString(),
                    Text = $"{e.Emp_firstname} {e.Emp_surname}"
                })
                .ToListAsync();
            EmployeeList = employees;
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error loading employees: {ex.Message}", ToastType.Warning, "warning");
        }
    }

    private async Task GetUserRightsDetails()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        if (EmpId == 0)
        {
            UserRightsList = new List<MenuModel>();
            UserRight = new UserRightsModel();
            editContext = new EditContext(UserRight);
            editContext.NotifyValidationStateChanged();
            return;
        }
        UserRight.EmpId = EmpId;
        UserRightsList = await MenuService.GetMenuTreeAsync();

        var userRights = await db.Mst_UserRight_New.Where(rp => rp.EmpID == UserRight.EmpId && rp.DeletedBy == null).Select(rp => new { rp.MenuID, rp.RID }).ToListAsync();
        var userRightsList = await db.Mst_UserRight_New.Where(rp => rp.EmpID == UserRight.EmpId && rp.DeletedBy == null).ToListAsync();
        UserRight.UserRights.AddRange(userRightsList);
        foreach (var record in userRights)
        {
            // Find parent or submenu with this MenuID
            var menu = FindMenuById(UserRightsList, record.MenuID.Value);

            if (menu != null)
            {
                menu.IsChecked = true;

                // Split RID string (example: "1,2,3,4")
                var rightIds = record.RID?.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                          .Select(int.Parse)
                                          .ToList();

                if (menu.Rights != null && rightIds != null)
                {
                    foreach (var right in menu.Rights.Where(r => rightIds.Contains(r.rights.RID)))
                    {
                        right.IsChecked = true;
                    }
                }

                // Mark parent checked if submenu is checked
                MarkParentChecked(UserRightsList, menu.PMID);
            }
        }

        // ✅ Clear validation messages after successful load
        editContext = new EditContext(UserRight);
        editContext.NotifyValidationStateChanged();

        // 4️⃣ Update Select All checkbox if all are checked
        UpdateSelectAllState();
        StateHasChanged();
    }

    // Recursively find menu or submenu by MenuID
    private MenuModel? FindMenuById(List<MenuModel> menus, int menuId)
    {
        foreach (var menu in menus)
        {
            if (menu.MID == menuId)
                return menu;

            var found = FindMenuById(menu.SubMenus, menuId);
            if (found != null)
                return found;
        }
        return null;
    }

    // Marks parent menu checked when any child/submenu is checked
    private void MarkParentChecked(List<MenuModel> menus, int? parentId)
    {
        if (parentId == null)
            return;

        var parent = FindMenuById(menus, parentId.Value);
        if (parent != null)
        {
            parent.IsChecked = true;
            MarkParentChecked(menus, parent.PMID);
        }
    }

    // -------------------------------
    // MAIN TOGGLE: Parent Menu
    // -------------------------------
    private void ToggleMenu(MenuModel parent, bool isChecked)
    {
        parent.IsChecked = isChecked;

        if (parent.SubMenus.Any())
        {
            // parent has submenus → only save RID = 4
            if (isChecked)
                AddUserRight(parent.MID, "4");
            else
                UserRight.UserRights.RemoveAll(x => x.MenuID == parent.MID);

            // apply to all submenus
            foreach (var sub in parent.SubMenus)
            {
                ToggleSubMenu(parent, sub, isChecked, fromParent: true);
            }
        }
        else
        {
            // Parent without children → use full rights list from parent.Rights
            if (isChecked)
            {
                var allRids = string.Join(",", parent.Rights.Select(r => r.rights.RID));
                AddUserRight(parent.MID, allRids);

                foreach (var r in parent.Rights)
                    r.IsChecked = true;
            }
            else
            {
                foreach (var r in parent.Rights)
                    r.IsChecked = false;

                UserRight.UserRights.RemoveAll(x => x.MenuID == parent.MID);
            }
        }
        UpdateSelectAllState();
        //StateHasChanged();
    }



    // -------------------------------
    // SUBMENU toggle logic
    // -------------------------------
    private void ToggleSubMenu(MenuModel parent, MenuModel submenu, bool isChecked, bool fromParent = false)
    {
        submenu.IsChecked = isChecked;

        if (isChecked)
        {
            // If parent triggered → select all rights
            if (fromParent && submenu.Rights != null)
            {
                foreach (var r in submenu.Rights)
                    r.IsChecked = true;
            }

            var selected = submenu.Rights
                .Where(r => r.IsChecked)
                .Select(r => r.rights.RID)
                .ToList() ?? new List<int>();

            AddUserRight(submenu.MID, string.Join(",", selected));
        }
        else
        {
            // unselect all rights when submenu unchecked
            if (submenu.Rights != null)
            {
                foreach (var r in submenu.Rights)
                    r.IsChecked = false;
            }

            UserRight.UserRights.RemoveAll(x => x.MenuID == submenu.MID);
        }

        // update parent checked state (auto-check/uncheck)
        UpdateParentAutoCheck(parent);
        UpdateSelectAllState();
    }




    // -------------------------------
    // TOGGLE RIGHT (submenu or parent)
    // -------------------------------
    private void ToggleRight(MenuModel menu, RightsModel right, bool isChecked)
    {
        right.IsChecked = isChecked;

        var selectedRids = menu.Rights
            .Where(r => r.IsChecked)
            .Select(r => r.rights.RID)
            .ToList();

        if (selectedRids.Count > 0)
        {
            AddUserRight(menu.MID, string.Join(",", selectedRids));

            // auto check menu if any right is selected
            menu.IsChecked = true;
            if (UserRightsList.Any(u => u.SubMenus.Any(su => su.MID == menu.MID)))
            {
                var parentmenu = UserRightsList.Where(u => u.SubMenus.Any(su => su.MID == menu.MID)).FirstOrDefault();
                parentmenu.IsChecked = true;
            }
        }
        else
        {
            // no rights selected → remove entry
            UserRight.UserRights.RemoveAll(x => x.MenuID == menu.MID);
            menu.IsChecked = false;
            if (UserRightsList.Any(u => u.SubMenus.Any(su => su.MID == menu.MID)))
            {
                var parentmenu = UserRightsList.Where(u => u.SubMenus.Any(su => su.MID == menu.MID)).FirstOrDefault();
                parentmenu.IsChecked = false;
            }
        }

        //StateHasChanged();
        UpdateSelectAllState();
    }

    private void ToggleSelectAll(bool isChecked)
    {
        foreach (var parent in UserRightsList)
        {
            ToggleMenu(parent, isChecked);
        }

        StateHasChanged();
    }

    private void UpdateSelectAllState()
    {
        IsAllSelected = UserRightsList.All(m => IsMenuFullyChecked(m));
        StateHasChanged();
    }

    // ✅ Checks if a menu and all its children are fully selected
    private bool IsMenuFullyChecked(MenuModel menu)
    {
        bool selfChecked = menu.IsChecked;

        bool rightsChecked = menu.Rights == null || menu.Rights.All(r => r.IsChecked);

        bool subChecked = !menu.SubMenus.Any() || menu.SubMenus.All(sm => IsMenuFullyChecked(sm));

        return selfChecked && rightsChecked && subChecked;
    }


    // -------------------------------
    // Parent WITH NO Submenus
    // dynamic CSV from rights
    // -------------------------------
    private void UpdateParentMenuRights(MenuModel parent)
    {
        UserRight.UserRights?.RemoveAll(x => x.MenuID == parent.MID);

        var selectedRights = parent.Rights
            .Where(r => r.IsChecked)
            .Select(r => r.rights.RID)
            .ToList();

        if (selectedRights?.Any() == true)
        {
            AddUserRight(parent.MID, string.Join(",", selectedRights));
            parent.IsChecked = true;
        }
        else
        {
            parent.IsChecked = false;
        }
    }



    // -------------------------------
    // SUBMENU dynamic CSV update
    // -------------------------------
    private void UpdateSubMenuRights(MenuModel submenu)
    {
        UserRight.UserRights?.RemoveAll(x => x.MenuID == submenu.MID);

        var selectedRights = submenu.Rights
            .Where(r => r.IsChecked)
            .Select(r => r.rights.RID)
            .ToList();

        if (selectedRights.Any())
        {
            AddUserRight(submenu.MID, string.Join(",", selectedRights));
            submenu.IsChecked = true;
        }
        else
        {
            submenu.IsChecked = false;
        }
    }



    // -------------------------------
    // AUTO CHECK PARENT
    // -------------------------------
    private void UpdateParentAutoCheck(MenuModel parent)
    {
        //UserRight.UserRights?.RemoveAll(x => x.MenuID == parent.MID);

        bool allChecked = parent.SubMenus.All(sm => sm.IsChecked);

        parent.IsChecked = allChecked;

        if (allChecked)
            AddUserRight(parent.MID, "4"); // parent always gets only 4
    }



    // -------------------------------
    // helper
    // -------------------------------
    private void AddUserRight(int menuId, string rid)
    {
        if (!UserRight.UserRights.Any(x => x.MenuID == menuId))
        {
            UserRight.UserRights.Add(new Mst_UserRight_New
            {
                EmpID = UserRight.EmpId,
                MenuID = menuId,
                RID = rid,
            });
        }
        else
        {
            // update existing entry
            var existing = UserRight.UserRights.First(x => x.MenuID == menuId);
            existing.RID = rid;
        }
    }

    private async Task SaveUserRights()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        foreach (var userRights in UserRight.UserRights)
        {
            var empRight = await db.Mst_UserRight_New.Where(u => u.DeletedBy == null && u.EmpID == userRights.EmpID && u.MenuID == userRights.MenuID).FirstOrDefaultAsync();
            if (empRight != null)
            {
                empRight.RID = userRights.RID;
                empRight.UpdatedOn = DateTime.Now;
                await db.SaveChangesAsync();
            }
            else
            {
                Mst_UserRight_New newempRights = new Mst_UserRight_New
                {
                    EmpID = userRights.EmpID,
                    MenuID = userRights.MenuID,
                    RID = userRights.RID,
                    CreatedOn = DateTime.Now,
                };
                db.Mst_UserRight_New.Add(newempRights);
                await db.SaveChangesAsync();
            }
        }

        var deluserrights = await db.Mst_UserRight_New.Where(u => u.DeletedBy == null && u.EmpID == UserRight.EmpId).ToListAsync();

        foreach (var item in deluserrights)
        {
            var delobj = UserRight.UserRights.Where(u => u.MenuID == item.MenuID).FirstOrDefault();
            if (delobj == null)
            {
                item.DeletedBy = UserRight.EmpId;
                item.DeletedOn = DateTime.Now;
                await db.SaveChangesAsync();
            }
        }

        EmpId = 0;
        UserRightsList = new List<MenuModel>();
        UserRight = new UserRightsModel();
        editContext = new EditContext(UserRight);
        editContext.NotifyValidationStateChanged();

        ToastService.Show("User Rights saved successfully.", ToastType.Success, "Saved");
    }

    

}
