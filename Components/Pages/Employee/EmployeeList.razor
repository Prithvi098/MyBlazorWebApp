@page "/employeelist"
@attribute [Authorize]
@layout MainLayout
@inject IDbContextFactory<EMSContext> DbFactory
@inject AppToastService ToastService
@inject NavigationManager Navigation
@inject Helper _helper
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Employee List</PageTitle>

<style>

    .table-overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(255, 255, 255, 0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 5;
        transition: opacity 0.3s ease-in-out;
    }

</style>

<section class="content">
    <div class="content-header">
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-5 col-lg-6">
                    <div class="main-title">
                        <h2>Employee List</h2>
                    </div>
                </div>
                <div class="col-6 col-lg-6">
                    <div class="float-right">
                        <a class="btn btn-outline-primary" @onclick="() => GetInActiveEmployeeList()">
                            @(IsActive ? "InActive Employee List" : "Active Employee List")
                        </a>
                        <a href="/employeecreate" class="btn btn-success">
                            <i class="fa-solid fa-plus"></i> Add Employee
                        </a>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid p-0">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            
                            <div class="col-md-6 float-left">
                                <div class="mb-2">
                                    <label class="me-2 fw-semibold">Page Size:</label>
                                    <select class="form-select d-inline-block w-auto" @onchange="OnPageSizeChanged">
                                        @foreach (var size in PageSizes)
                                        {
                                            <option value="@size" selected="@(size == PageSize)">@size</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-2 float-right">
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fa-solid fa-search"></i>
                                        </span>
                                        <input type="text" class="form-control" placeholder="Search..." @bind="GlobalSearch" @bind:event="oninput" />
                                        @if (!string.IsNullOrEmpty(GlobalSearch))
                                        {
                                            <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (IsGridLoading)
                        {
                            <div class="table-overlay">
                                @* <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div> *@
                                <Spinner Color="SpinnerColor.Primary" Type="SpinnerType.Border" Size="SpinnerSize.Large" />
                            </div>
                        }
                        <Grid @ref="employeeGrid"
                              TItem="EmployeeListModel"
                              Class="table table-hover table-bordered table-striped"
                              DataProvider="LoadEmployeesDataProvider"
                              AllowFiltering="false"
                              AllowPaging="true"
                              AllowSorting="true"
                              AllowSelection="false"
                              PageSize=@PageSize
                              Responsive="true">

                            <GridColumns>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Emp ID" PropertyName="Empid" SortKeySelector="e => e.Empid" IsDefaultSortColumn="true" SortString="Empid">
                                    @context.Empid
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="First Name" PropertyName="EmpFirstName" SortKeySelector="e => e.EmpFirstName" SortString="EmpFirstName">
                                    @context.EmpFirstName
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Last Name" PropertyName="EmpLastName" SortKeySelector="e => e.EmpLastName" SortString="EmpLastName">
                                    @context.EmpLastName
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Username" PropertyName="Username" SortKeySelector="e => e.Username" SortString="Username">
                                    @context.Username
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Email" PropertyName="Email" SortKeySelector="e => e.Email" SortString="Email">
                                    @context.Email
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Department" PropertyName="DepartmentName" SortKeySelector="e => e.DepartmentName" SortString="DepartmentName">
                                    @context.DepartmentName
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Active" PropertyName="IsActive" Filterable="false">
                                    <input type="checkbox" checked="@context.IsActive" disabled />
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Action" Filterable="false">
                                    <button class="btn btn-sm btn-primary me-1" @onclick="@(() => EditEmployee(context.Empid))">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="@(() => AskDelete(context.Empid))">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </GridColumn>
                            </GridColumns>

                        </Grid>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@if (IsLoading)
{
    <Loader />
}

<ConfirmationModal Show="@ShowConfirmDialog"
                   Title="Delete Employee"
                   Message="Are you sure you want to delete this employee?"
                   ConfirmationChanged="OnDeleteConfirmation" />

@code {
    private List<EmployeeListModel> employeelist = new List<EmployeeListModel>();
    private bool IsActive { get; set; } = true;
    private bool ShowConfirmDialog { get; set; }
    private int DeleteEmpId { get; set; }
    private bool IsLoading { get; set; } = false;
    private bool IsGridLoading = false;

    private string _globalSearchText = string.Empty;
    private string GlobalSearch
    {
        get => _globalSearchText;
        set
        {
            if (_globalSearchText != value)
            {
                _globalSearchText = value;
                DebounceSearch();
            }
        }
    }
    private int PageSize { get; set; } = 10;
    private List<int> PageSizes = new() { 5, 10, 25, 50, 100 };
    private BlazorBootstrap.Grid<EmployeeListModel>? employeeGrid;
    private System.Timers.Timer? _debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        //await LoadEmployees();
    }

    private async Task<GridDataProviderResult<EmployeeListModel>> LoadEmployeesDataProvider(GridDataProviderRequest<EmployeeListModel> request)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        try
        {
            IsGridLoading = true;
            await InvokeAsync(StateHasChanged);

            //await Task.Delay(400);
            var baseQuery =
                from e in db.Mst_Employees
                join d in db.Mst_Department.Where(x => x.DeletedBy == null)
                    on e.Department_type equals d.Id into deptJoin
                from d in deptJoin.DefaultIfEmpty()
                where e.DeletedBy == null && e.IsActive == IsActive
                select new
                {
                    e.Emp_id,
                    e.Emp_firstname,
                    e.Emp_surname,
                    e.Username,
                    e.Email_address,
                    DepartmentName = d != null ? d.DepartmentName : string.Empty,
                    e.IsActive
                };

            // global search
            if (!string.IsNullOrWhiteSpace(GlobalSearch))
            {
                var lower = GlobalSearch.ToLower();
                baseQuery = baseQuery.Where(x =>
                    x.Emp_firstname.ToLower().Contains(lower) ||
                    x.Emp_surname.ToLower().Contains(lower) ||
                    x.Username.ToLower().Contains(lower) ||
                    x.Email_address.ToLower().Contains(lower) ||
                    x.DepartmentName.ToLower().Contains(lower));
            }

            // sorting (simple first-sort, follow your previous switch if you need more)
            if (request.Sorting != null && request.Sorting.Any())
            {
                var sort = request.Sorting.First();
                switch (sort.SortString)
                {
                    case nameof(EmployeeListModel.Empid):
                        baseQuery = sort.SortDirection == SortDirection.Descending
                            ? baseQuery.OrderByDescending(x => x.Emp_id)
                            : baseQuery.OrderBy(x => x.Emp_id);
                        break;
                    case nameof(EmployeeListModel.EmpFirstName):
                        baseQuery = sort.SortDirection == SortDirection.Descending
                            ? baseQuery.OrderByDescending(x => x.Emp_firstname)
                            : baseQuery.OrderBy(x => x.Emp_firstname);
                        break;
                    case nameof(EmployeeListModel.EmpLastName):
                        baseQuery = sort.SortDirection == SortDirection.Descending
                            ? baseQuery.OrderByDescending(x => x.Emp_surname)
                            : baseQuery.OrderBy(x => x.Emp_surname);
                        break;
                    case nameof(EmployeeListModel.Username):
                        baseQuery = sort.SortDirection == SortDirection.Descending
                            ? baseQuery.OrderByDescending(x => x.Username)
                            : baseQuery.OrderBy(x => x.Username);
                        break;
                    case nameof(EmployeeListModel.Email):
                        baseQuery = sort.SortDirection == SortDirection.Descending
                            ? baseQuery.OrderByDescending(x => x.Email_address)
                            : baseQuery.OrderBy(x => x.Email_address);
                        break;
                    case nameof(EmployeeListModel.DepartmentName):
                        baseQuery = sort.SortDirection == SortDirection.Descending
                            ? baseQuery.OrderByDescending(x => x.DepartmentName)
                            : baseQuery.OrderBy(x => x.DepartmentName);
                        break;
                    default:
                        baseQuery = baseQuery.OrderBy(x => x.Emp_id);
                        break;
                }
            }
            else
            {
                baseQuery = baseQuery.OrderBy(x => x.Emp_id);
            }

            // paging: use request.PageNumber and request.PageSize
            var total = await baseQuery.CountAsync();
            var pageNumber = request.PageNumber <= 0 ? 1 : request.PageNumber; // defensive
            var pageSize = request.PageSize <= 0 ? PageSize : request.PageSize;

            var rows = await baseQuery
                .Skip((pageNumber - 1) * pageSize)
                .Take(pageSize)
                .Select(x => new EmployeeListModel
                {
                    Empid = x.Emp_id,
                    EmpFirstName = x.Emp_firstname,
                    EmpLastName = x.Emp_surname,
                    Username = x.Username,
                    Email = x.Email_address,
                    DepartmentName = x.DepartmentName,
                    IsActive = x.IsActive ?? false
                })
                .ToListAsync();

            // 🟢 Trigger fade-in after grid refresh
            await Task.Delay(400); // slight delay for DOM to update
            await JS.InvokeVoidAsync("fadeGridRows");

            return new GridDataProviderResult<EmployeeListModel>
            {
                Data = rows,
                TotalCount = total
            };
        }
        catch (Exception ex)
        {
            _helper.SaveException(ex, "EmployeeList/LoadEmployeesDataProvider");
            ToastService.Show("Error loading employee data", ToastType.Danger, "Error");
            return new GridDataProviderResult<EmployeeListModel>
            {
                Data = new List<EmployeeListModel>(),
                TotalCount = 0
            };
        }
        finally
        {
            // hide overlay
            IsGridLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            PageSize = newSize;
            // Force re-render of grid (Blazor.Bootstrap refreshes automatically on parameter change)
        }
    }

    private void DebounceSearch()
    {
        _debounceTimer?.Stop();
        _debounceTimer = new System.Timers.Timer(400); // 400ms delay after typing stops
        _debounceTimer.Elapsed += async (_, _) =>
        {
            _debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                if (employeeGrid is not null)
                    await employeeGrid.RefreshDataAsync();
            });
        };
        _debounceTimer.Start();
    }

    private async Task ClearSearch()
    {
        GlobalSearch = string.Empty;
        if (employeeGrid is not null)
            await employeeGrid.RefreshDataAsync();
    }

    private async Task RefreshGridAsync()
    {
        if (employeeGrid is not null)
            await employeeGrid.RefreshDataAsync();
    }

    private void AskDelete(int id)
    {
        DeleteEmpId = id;
        ShowConfirmDialog = true;
    }

    private async Task OnDeleteConfirmation(bool confirmed)
    {
        ShowConfirmDialog = false;
        if (confirmed)
        {
            await DeleteEmployee(DeleteEmpId);
        }
    }



    private async Task GetInActiveEmployeeList()
    {
        IsActive = !IsActive;
        if (employeeGrid is not null)
        {
            // The grid provides a reload method in Blazor.Bootstrap.
            // Depending on your exact package minor, method name can be ReloadDataAsync or ReloadAsync.
            // Try ReloadDataAsync() first; if compiler complains, try ReloadAsync().
            await employeeGrid.RefreshDataAsync();
        }
        else
        {
            StateHasChanged();
        }
    }

    private void EditEmployee(int EmpId)
    {
        Navigation.NavigateTo($"/employeeedit/{EmpId}");
    }

    async Task DeleteEmployee(int Id)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            var emp = await db.Mst_Employees.Where(e => e.Emp_id == Id).FirstOrDefaultAsync();

            if (emp == null) { ToastService.Show("No Data Found.", ToastType.Danger, "Error"); return; }

            emp.DeletedBy = 1;
            emp.DeletedOn = DateTime.Now;
            await db.SaveChangesAsync();
            ToastService.Show("Employee Deleted Successfully.", ToastType.Success, "Success");

            //await LoadEmployees();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _helper.SaveException(ex, "EmployeeList/DeleteEmployee");
            ToastService.Show("Error while Deleting Employee", ToastType.Danger, "Error");
        }
    }

    private class EmployeeListModel
    {
        public int Empid { get; set; }
        public string? EmpFirstName { get; set; }
        public string? EmpLastName { get; set; }
        public string? Username { get; set; }
        public string? Email { get; set; }
        public string? DepartmentName { get; set; }
        public bool IsActive { get; set; }
    }
}
