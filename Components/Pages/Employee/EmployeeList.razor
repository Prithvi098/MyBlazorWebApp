@page "/employeelist"
@attribute [Authorize]
@layout MainLayout
@inject IDbContextFactory<EMSContext> DbFactory
@inject AppToastService ToastService
@inject NavigationManager Navigation
@inject Helper _helper
@inject IJSRuntime JS
@inject ProtectedSessionStorage ProtectedBrowserStorage
@inject EmployeeNavigationState EmployeeNav
@rendermode InteractiveServer

<PageTitle>Employee List</PageTitle>

<AuthorizeMenu MenuUrl="/employeelist">
    <section class="content page-section">
        <div class="content-header">
            <div class="container-fluid p-0">
                <div class="row align-items-center g-3">
                    <div class="col-12 col-lg-5">
                        <div class="main-title">
                            <h2>Employee List</h2>
                        </div>
                    </div>
                    <div class="col-12 col-lg-7">
                        <div class="page-actions">
                            <RadzenButton Text="@(IsActive ? "Inactive Employee List" : "Active Employee List")"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Click="@GetInActiveEmployeeList" />
                            <RadzenButton Text="Add Employee"
                                          Click="@CreateEmployee" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-12">
                    <div class="card content-surface-card">
                        <div class="card-body">
                            <div class="row align-items-end g-3">

                                <div class="col-12 col-md-6">
                                    <div class="mb-2 list-toolbar-label">
                                        <label class="me-2 fw-semibold">Page Size:</label>
                                        <select class="form-select d-inline-block w-auto" @onchange="OnPageSizeChanged">
                                            @foreach (var size in PageSizes)
                                            {
                                                <option value="@size" selected="@(size == PageSize)">@size</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="mb-2">
                                        <div class="input-group search-shell">
                                            <span class="input-group-text bg-light">
                                                <i class="fa-solid fa-search"></i>
                                            </span>
                                            <input type="text" class="form-control" placeholder="Search..." @bind="GlobalSearch" @bind:event="oninput" />
                                            @if (!string.IsNullOrEmpty(GlobalSearch))
                                            {
                                                <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @* @if (IsGridLoading)
                            {
                                <div class="table-overlay">
                                    <Spinner Color="SpinnerColor.Primary" Type="SpinnerType.Border" Size="SpinnerSize.Large" />
                                </div>
                            } *@
                            <RadzenDataGrid @ref="employeeGrid"
                                            TItem="EmployeeListModel"
                                            Data="@employeelist"
                                            Count="@TotalCount"
                                            LoadData="@LoadEmployees"
                                            AllowPaging="true"
                                            AllowSorting="true"
                                            AllowFiltering="false"
                                            PageSize="@PageSize"
                                            IsLoading="@IsGridLoading"
                                            Responsive="true"
                                            ShowPagingSummary="true"
                                            PagerHorizontalAlign="HorizontalAlign.Right"
                                            EmptyText="No employees found."
                                            Class="app-data-grid radzen-employee-grid">
                                <Columns>
                                    <RadzenDataGridColumn TItem="EmployeeListModel" Property="@nameof(EmployeeListModel.Empid)" Title="Emp ID" />
                                    <RadzenDataGridColumn TItem="EmployeeListModel" Property="@nameof(EmployeeListModel.EmpFirstName)" Title="First Name" />
                                    <RadzenDataGridColumn TItem="EmployeeListModel" Property="@nameof(EmployeeListModel.EmpLastName)" Title="Last Name" />
                                    <RadzenDataGridColumn TItem="EmployeeListModel" Property="@nameof(EmployeeListModel.Username)" Title="Username" />
                                    <RadzenDataGridColumn TItem="EmployeeListModel" Property="@nameof(EmployeeListModel.Email)" Title="Email" />
                                    <RadzenDataGridColumn TItem="EmployeeListModel" Property="@nameof(EmployeeListModel.DepartmentName)" Title="Department" />
                                    <RadzenDataGridColumn TItem="EmployeeListModel" Title="Active" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                        <Template Context="employee">
                                            <input type="checkbox" checked="@employee.IsActive" disabled />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="EmployeeListModel" Title="Action" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                        <Template Context="employee">
                                            <button class="btn btn-sm btn-primary me-1 grid-action-button" @onclick="@(() => EditEmployee(employee.Empid))">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger grid-action-button" @onclick="@(() => AskDelete(employee.Empid))">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (IsLoading)
    {
        <Loader />
    }

    <ConfirmationModal Show="@ShowConfirmDialog"
                       Title="Delete Employee"
                       Message="Are you sure you want to delete this employee?"
                       ConfirmationChanged="OnDeleteConfirmation" />

</AuthorizeMenu>

@code {
    private List<EmployeeListModel> employeelist = new();
    private int TotalCount { get; set; }
    private bool IsActive { get; set; } = true;
    private bool ShowConfirmDialog { get; set; }
    private int DeleteEmpId { get; set; }
    private bool IsLoading { get; set; } = false;
    private bool IsGridLoading = false;

    private string _globalSearchText = string.Empty;
    private string GlobalSearch
    {
        get => _globalSearchText;
        set
        {
            if (_globalSearchText != value)
            {
                _globalSearchText = value;
                DebounceSearch();
            }
        }
    }
    private int PageSize { get; set; } = 10;
    private List<int> PageSizes = new() { 5, 10, 25, 50, 100 };
    private RadzenDataGrid<EmployeeListModel>? employeeGrid;
    private System.Timers.Timer? _debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(200);
        await ReloadGridAsync();
    }

    

    private async Task LoadEmployees(LoadDataArgs args)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        try
        {
            IsGridLoading = true;
            await InvokeAsync(StateHasChanged);

            var baseQuery =
                from e in db.Mst_Employees
                join d in db.Mst_Department.Where(x => x.DeletedBy == null)
                    on e.Department_type equals d.Id into deptJoin
                from d in deptJoin.DefaultIfEmpty()
                where e.DeletedBy == null && e.IsActive == IsActive
                select new EmployeeGridRow
                {
                    Empid = e.Emp_id,
                    EmpFirstName = e.Emp_firstname,
                    EmpLastName = e.Emp_surname,
                    Username = e.Username,
                    Email = e.Email_address,
                    DepartmentName = d != null ? d.DepartmentName : string.Empty,
                    IsActive = e.IsActive ?? false
                };

            if (!string.IsNullOrWhiteSpace(GlobalSearch))
            {
                var lower = GlobalSearch.ToLower();
                baseQuery = baseQuery.Where(x =>
                    x.EmpFirstName.ToLower().Contains(lower) ||
                    x.EmpLastName.ToLower().Contains(lower) ||
                    x.Username.ToLower().Contains(lower) ||
                    x.Email.ToLower().Contains(lower) ||
                    x.DepartmentName.ToLower().Contains(lower));
            }

            baseQuery = ApplySorting(baseQuery, args.OrderBy);

            TotalCount = await baseQuery.CountAsync();
            var skip = args.Skip ?? 0;
            var take = args.Top ?? PageSize;

            employeelist = await baseQuery
                .Skip(skip)
                .Take(take)
                .Select(x => new EmployeeListModel
                {
                    Empid = x.Empid,
                    EmpFirstName = x.EmpFirstName,
                    EmpLastName = x.EmpLastName,
                    Username = x.Username,
                    Email = x.Email,
                    DepartmentName = x.DepartmentName,
                    IsActive = x.IsActive
                })
                .ToListAsync();

            await Task.Delay(400); // slight delay for DOM to update
            await JS.InvokeVoidAsync("fadeGridRows");
        }
        catch (Exception ex)
        {
            _helper.SaveException(ex, "EmployeeList/LoadEmployeesDataProvider");
            ToastService.Show("Error loading employee data", ToastType.Danger, "Error");
            employeelist = new();
            TotalCount = 0;
        }
        finally
        {
            IsGridLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            PageSize = newSize;
            await ReloadGridAsync();
        }
    }

    private void DebounceSearch()
    {
        _debounceTimer?.Stop();
        _debounceTimer = new System.Timers.Timer(400); // 400ms delay after typing stops
        _debounceTimer.Elapsed += async (_, _) =>
        {
            _debounceTimer?.Stop();
            await InvokeAsync(ReloadGridAsync);
        };
        _debounceTimer.Start();
    }

    private async Task ClearSearch()
    {
        GlobalSearch = string.Empty;
        await ReloadGridAsync();
    }

    private async Task ReloadGridAsync()
    {
        if (employeeGrid is not null)
        {
            await employeeGrid.Reload();
        }
        IsGridLoading = false;
    }

    private void AskDelete(int id)
    {
        DeleteEmpId = id;
        ShowConfirmDialog = true;
    }

    private async Task OnDeleteConfirmation(bool confirmed)
    {
        ShowConfirmDialog = false;
        if (confirmed)
        {
            await DeleteEmployee(DeleteEmpId);
        }
    }

    private async Task GetInActiveEmployeeList()
    {
        IsActive = !IsActive;
        IsGridLoading = true;
        await ReloadGridAsync();
    }

    private async Task EditEmployee(int EmpId)
    {
        //await ProtectedBrowserStorage.SetAsync("EditEmployeeId", EmpId);
        EmployeeNav.EditEmpId = EmpId;
        Navigation.NavigateTo($"/employeeedit");
    }

    private async Task CreateEmployee()
    {
        EmployeeNav.EditEmpId = null;
        Navigation.NavigateTo($"/employeecreate");
    }

    async Task DeleteEmployee(int Id)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            var emp = await db.Mst_Employees.Where(e => e.Emp_id == Id).FirstOrDefaultAsync();

            if (emp == null) { ToastService.Show("No Data Found.", ToastType.Danger, "Error"); return; }

            emp.DeletedBy = 1;
            emp.DeletedOn = DateTime.Now;
            await db.SaveChangesAsync();
            ToastService.Show("Employee Deleted Successfully.", ToastType.Success, "Success");
            await ReloadGridAsync();
        }
        catch (Exception ex)
        {
            _helper.SaveException(ex, "EmployeeList/DeleteEmployee");
            ToastService.Show("Error while Deleting Employee", ToastType.Danger, "Error");
        }
    }

    private static IQueryable<EmployeeGridRow> ApplySorting(IQueryable<EmployeeGridRow> query, string? orderBy)
    {
        if (string.IsNullOrWhiteSpace(orderBy))
        {
            return query.OrderBy(x => x.Empid);
        }

        var isDescending = orderBy.Contains(" desc", StringComparison.OrdinalIgnoreCase);

        if (orderBy.Contains(nameof(EmployeeListModel.EmpFirstName), StringComparison.OrdinalIgnoreCase))
        {
            return isDescending ? query.OrderByDescending(x => x.EmpFirstName) : query.OrderBy(x => x.EmpFirstName);
        }

        if (orderBy.Contains(nameof(EmployeeListModel.EmpLastName), StringComparison.OrdinalIgnoreCase))
        {
            return isDescending ? query.OrderByDescending(x => x.EmpLastName) : query.OrderBy(x => x.EmpLastName);
        }

        if (orderBy.Contains(nameof(EmployeeListModel.Username), StringComparison.OrdinalIgnoreCase))
        {
            return isDescending ? query.OrderByDescending(x => x.Username) : query.OrderBy(x => x.Username);
        }

        if (orderBy.Contains(nameof(EmployeeListModel.Email), StringComparison.OrdinalIgnoreCase))
        {
            return isDescending ? query.OrderByDescending(x => x.Email) : query.OrderBy(x => x.Email);
        }

        if (orderBy.Contains(nameof(EmployeeListModel.DepartmentName), StringComparison.OrdinalIgnoreCase))
        {
            return isDescending ? query.OrderByDescending(x => x.DepartmentName) : query.OrderBy(x => x.DepartmentName);
        }

        return isDescending ? query.OrderByDescending(x => x.Empid) : query.OrderBy(x => x.Empid);
    }

    private class EmployeeListModel
    {
        public int Empid { get; set; }
        public string? EmpFirstName { get; set; }
        public string? EmpLastName { get; set; }
        public string? Username { get; set; }
        public string? Email { get; set; }
        public string? DepartmentName { get; set; }
        public bool IsActive { get; set; }
    }

    private class EmployeeGridRow
    {
        public int Empid { get; set; }
        public string EmpFirstName { get; set; } = string.Empty;
        public string EmpLastName { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string DepartmentName { get; set; } = string.Empty;
        public bool IsActive { get; set; }
    }
}
