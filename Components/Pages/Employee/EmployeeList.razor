@page "/employeelist"
@attribute [Authorize]
@layout MainLayout
@inject IDbContextFactory<EMSContext> DbFactory
@inject AppToastService ToastService
@inject NavigationManager Navigation
@inject Helper _helper
@rendermode InteractiveServer

<PageTitle>Employee List</PageTitle>
<section class="content">
    <div class="content-header">
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-5 col-lg-6">
                    <div class="main-title">
                        <h2>Employee List</h2>
                    </div>
                </div>
                <div class="col-6 col-lg-6">
                    <div class="float-right">
                        <a class="btn btn-outline-primary" @onclick="() => GetInActiveEmployeeList()">
                            @(IsActive ? "InActive Employee List" : "Active Employee List")
                        </a>
                        <a href="/employeecreate" class="btn btn-success">
                            <i class="fa-solid fa-plus"></i> Add Employee
                        </a>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid p-0">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body table-responsive">
                        <Grid TItem="EmployeeListModel"
                              Class="table table-hover table-bordered table-striped"
                              DataProvider="LoadEmployeesDataProvider"
                              AllowFiltering="true"
                              AllowPaging="true"
                              AllowSorting="true"
                              AllowSelection="true"
                              PageSize="10"
                              Responsive="true">

                            <GridColumns>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Emp ID" PropertyName="Empid" SortKeySelector="e => e.Empid">
                                    @context.Empid
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="First Name" PropertyName="EmpFirstName" SortKeySelector="e => e.EmpFirstName">
                                    @context.EmpFirstName
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Last Name" PropertyName="EmpLastName" SortKeySelector="e => e.EmpLastName">
                                    @context.EmpLastName
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Username" PropertyName="Username" SortKeySelector="e => e.Username">
                                    @context.Username
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Email" PropertyName="Email" SortKeySelector="e => e.Email">
                                    @context.Email
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Department" PropertyName="DepartmentName" SortKeySelector="e => e.DepartmentName">
                                    @context.DepartmentName
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Active" PropertyName="IsActive" SortKeySelector="e => e.IsActive">
                                    <input type="checkbox" checked="@context.IsActive" disabled />
                                </GridColumn>
                                <GridColumn TItem="EmployeeListModel" HeaderText="Action">
                                    <button class="btn btn-sm btn-primary me-1" @onclick="@(() => EditEmployee(context.Empid))">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="@(() => AskDelete(context.Empid))">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </GridColumn>
                            </GridColumns>

                        </Grid>
                        @if (employeelist.Count == 0)
                        {
                            @* <table class="table table-bordered border-3 border-black">
                                <thead>
                                    <tr>
                                        <th>EmpId</th>
                                        <th>First Name</th>
                                        <th>Last Name</th>
                                        <th>Username</th>
                                        <th>Email</th>
                                        <th>Department</th>
                                        <th>Is Active</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table> *@
                        }
                        else
                        {
                            



                            @* <table class="table table-bordered border-3 border-black">
                                <thead>
                                    <tr>
                                        <th>EmpId</th>
                                        <th>First Name</th>
                                        <th>Last Name</th>
                                        <th>Username</th>
                                        <th>Email</th>
                                        <th>Department</th>
                                        <th>Is Active</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var employee in employeelist)
                                    {
                                        <tr>
                                            <td>@employee.Empid</td>
                                            <td>@employee.EmpFirstName</td>
                                            <td>@employee.EmpLastName</td>
                                            <td>@employee.Username</td>
                                            <td>@employee.Email</td>
                                            <td>@employee.DepartmentName</td>
                                            <td>
                                                <input type="checkbox" @bind="employee.IsActive" disabled />
                                            </td>
                                            <td>
                                                <a class="btn btn-sm btn-primary" @onclick="() => EditEmployee(employee.Empid)"><i class="fa-solid fa-pen"></i></a>
                                                <a class="btn btn-sm btn-danger" @onclick="() => AskDelete(employee.Empid)"><i class="fa-solid fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table> *@
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@if (IsLoading)
{
    <Loader />
}

<ConfirmationModal Show="@ShowConfirmDialog"
                   Title="Delete Employee"
                   Message="Are you sure you want to delete this employee?"
                   ConfirmationChanged="OnDeleteConfirmation" />

@code {
    private List<EmployeeListModel> employeelist = new List<EmployeeListModel>();
    private bool IsActive { get; set; } = true;
    private bool ShowConfirmDialog { get; set; }
    private int DeleteEmpId { get; set; }
    private bool IsLoading { get; set; } = false;

    private async Task<GridDataProviderResult<EmployeeListModel>> LoadEmployeesDataProvider(GridDataProviderRequest<EmployeeListModel> request)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var query =
                from e in db.Mst_Employees
                join d in db.Mst_Department.Where(x => x.DeletedBy == null)
                    on e.Department_type equals d.Id into deptJoin
                from d in deptJoin.DefaultIfEmpty()
                where e.DeletedBy == null && e.IsActive == IsActive
                select new EmployeeListModel
                {
                    Empid = e.Emp_id,
                    EmpFirstName = e.Emp_firstname,
                    EmpLastName = e.Emp_surname,
                    Username = e.Username,
                    Email = e.Email_address,
                    DepartmentName = d != null ? d.DepartmentName : string.Empty,
                    IsActive = e.IsActive ?? false
                };

            // ✅ Sorting (new API)
            if (request.Sorting.Any())
            {
                var sort = request.Sorting.FirstOrDefault();
                query = sort.SortDirection == SortDirection.Descending
                    ? query.OrderByDescending(e => EF.Property<object>(e, sort.SortString))
					: query.OrderBy(e => EF.Property<object>(e, sort.SortString));
            }
            else
            {
                query = query.OrderBy(e => e.Empid);
            }

            // ✅ Filtering (manual)
            if (request.Filters?.Any() == true)
            {
                foreach (var filter in request.Filters)
                {
                    var value = filter.Value?.ToString()?.ToLower();
                    if (string.IsNullOrWhiteSpace(value)) continue;

                    switch (filter.PropertyName)
                    {
                        case nameof(EmployeeListModel.EmpFirstName):
                            query = query.Where(e => e.EmpFirstName.ToLower().Contains(value));
                            break;
                        case nameof(EmployeeListModel.Email):
                            query = query.Where(e => e.Email.ToLower().Contains(value));
                            break;
                        case nameof(EmployeeListModel.DepartmentName):
                            query = query.Where(e => e.DepartmentName.ToLower().Contains(value));
                            break;
                    }
                }
            }

            // ✅ Paging (new API)
            var totalCount = await query.CountAsync();
            var data = await query
                .Skip(request.PageNumber)
                .Take(request.PageSize)
                .ToListAsync();

            // ✅ Result (new API)
            return new GridDataProviderResult<EmployeeListModel>
            {
                Data = data,
                TotalCount = totalCount
            };
        }
        catch (Exception ex)
        {
            _helper.SaveException(ex, "EmployeeList/LoadEmployeesDataProvider");
            ToastService.Show("Error loading employee data", ToastType.Danger, "Error");
            return new GridDataProviderResult<EmployeeListModel>
            {
                Data = new List<EmployeeListModel>(),
                TotalCount = 0
            };
        }
    }


    private void AskDelete(int id)
    {
        DeleteEmpId = id;
        ShowConfirmDialog = true;
    }

    private async Task OnDeleteConfirmation(bool confirmed)
    {
        ShowConfirmDialog = false;
        if (confirmed)
        {
            await DeleteEmployee(DeleteEmpId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        //await LoadEmployees();
    }

    private async Task GetInActiveEmployeeList()
    {
        IsActive = !IsActive;
        //await LoadEmployees();
    }

    private async Task EditEmployee(int EmpId)
    {
        Navigation.NavigateTo($"/employeeedit/{EmpId}");
    }

    async Task DeleteEmployee(int Id)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            var emp = await db.Mst_Employees.Where(e => e.Emp_id == Id).FirstOrDefaultAsync();

            if (emp == null)
                ToastService.Show("No Data Found.", ToastType.Danger, "Error");

            emp.DeletedBy = 1;
            emp.DeletedOn = DateTime.Now;
            await db.SaveChangesAsync();
            ToastService.Show("Employee Deleted Successfully.", ToastType.Success, "Success");

            //await LoadEmployees();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _helper.SaveException(ex, "EmployeeList/DeleteEmployee");
            ToastService.Show("Error while Deleting Employee", ToastType.Danger, "Error");
        }
    }

    private class EmployeeListModel
    {
        public int Empid { get; set; }
        public string? EmpFirstName { get; set; }
        public string? EmpLastName { get; set; }
        public string? Username { get; set; }
        public string? Email { get; set; }
        public string? DepartmentName { get; set; }
        public bool IsActive { get; set; }
    }
}
