    private void AskDelete()
    {
        ShowConfirmDialog = true;
    }

    private async Task OnConfirmation(bool confirmed)
    {
        ShowConfirmDialog = false;
        if (confirmed)
        {
            await SaveEmployee();
        }
    }

    private async Task SaveEmployee()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            if (employee.Emp_id == 0)
            {
                var lastemp = db.Mst_Employees.Where(e => e.DeletedBy == null && e.Emp_code != null && e.Emp_code != "" && e.Emp_code.StartsWith("TVSSL")).OrderByDescending(e => e.Emp_id).FirstOrDefault();
                var laempcode = lastemp == null ? "TVSSL-001" : lastemp.Emp_code;
                var lastcodenumber = int.Parse(laempcode.Split('-')[1]);
                employee.Emp_code = "TVSSL-" + (lastcodenumber + 1).ToString();
                employee.Password = _helper.Encrypt(plainPassword);
                db.Mst_Employees.Add(employee);
                await db.SaveChangesAsync();
                ToastService.Show("Employee Saved Successfully.", ToastType.Success, "Success");
                db.Dispose();
                Navigation.NavigateTo("/employeelist");
            }
            else
            {
                var existingEmployee = await db.Mst_Employees.Where(e => e.DeletedBy == null && e.Emp_id == employee.Emp_id).FirstOrDefaultAsync();
                existingEmployee.Emp_firstname = employee.Emp_firstname;
                existingEmployee.Emp_middlename = employee.Emp_middlename;
                existingEmployee.Emp_surname = employee.Emp_surname;
                existingEmployee.Email_address = employee.Email_address;
                existingEmployee.Username = employee.Username;
                existingEmployee.Department_type = employee.Department_type;
                existingEmployee.Password = _helper.Encrypt(plainPassword);
                await db.SaveChangesAsync();
                ToastService.Show("Employee Updated Successfully.", ToastType.Success, "Success");
                db.Dispose();
                Navigation.NavigateTo("/employeelist");
            }
        }
        catch (Exception ex)
        {
            _helper.SaveException(ex, "EmployeeCreate/SaveEmployee");
            ToastService.Show("Error while saving Employee details", ToastType.Danger, "Error");
        }
    }

}
