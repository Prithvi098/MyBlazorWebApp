@page "/department"
@layout MainLayout
@attribute [Authorize]
@* @inject EMSContext Db *@
@inject IDbContextFactory<EMSContext> DbFactory
@inject IJSRuntime JS
@inject Helper _helper
@inject AppToastService ToastService
@rendermode InteractiveServer

<PageTitle>Department</PageTitle>

<style>

    .table-overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(255, 255, 255, 0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 5;
        transition: opacity 0.3s ease-in-out;
    }

</style>

<section class="content">
    <div class="content-header">
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-5 col-lg-6">
                    <div class="main-title">
                        <h3>Department</h3>
                    </div>
                </div>
                <div class="col-6 col-lg-6">
                    <div class="float-right">
                        <button href="#" class="btn btn-success" @onclick="OpenAddModal">
                            <i class="fa-solid fa-plus"></i> Add Department
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid p-0">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body table-responsive">
                        <div class="row mb-2">
                            <!-- Page Size -->
                            <div class="col-md-6">
                                <label class="fw-semibold me-2">Page Size:</label>
                                <select class="form-select d-inline-block w-auto" @onchange="OnPageSizeChanged">
                                    @foreach (var size in PageSizes)
                                    {
                                        <option value="@size" selected="@(size == PageSize)">@size</option>
                                    }
                                </select>
                            </div>

                            <!-- Search -->
                            <div class="col-md-6">
                                <div class="float-right">
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fa-solid fa-search"></i>
                                        </span>
                                        <input type="text" class="form-control" placeholder="Search..." @bind="GlobalSearch" @bind:event="oninput" />
                                        @if (!string.IsNullOrEmpty(GlobalSearch))
                                        {
                                            <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Loader -->
                        @if (IsGridLoading)
                        {
                            <div class="table-overlay">
                                <Spinner Color="SpinnerColor.Primary" Type="SpinnerType.Border" Size="SpinnerSize.Large" />
                            </div>
                        }

                        <!-- Grid -->
                        <Grid TItem="Departmentdata"
                              Class="table table-head-fixed text-nowrap m-0 w-100 responsive-tbl"
                              AllowFiltering="false"
                              AllowPaging="true"
                              AllowSorting="true"
                              AllowSelection="false"
                              PageSize="@PageSize"
                              Responsive="true"
                              Data="@FilteredDepartment">

                            <GridColumns>
                                <GridColumn TItem="Departmentdata" HeaderText="Department Name" SortKeySelector="e => e.DepartmentName">
                                    @context.DepartmentName
                                </GridColumn>
                                <GridColumn TItem="Departmentdata" HeaderText="Is Active" Filterable="false">
                                    <input type="checkbox" checked="@context.Isactive" disabled />
                                </GridColumn>
                                <GridColumn TItem="Departmentdata" HeaderText="Is Sub Department" Filterable="false">
                                    <input type="checkbox" checked="@context.IsSubDepartment" disabled />
                                </GridColumn>
                                <GridColumn TItem="Departmentdata" HeaderText="Department Name" SortKeySelector="e => e.ParentDepartmentName">
                                    @context.ParentDepartmentName
                                </GridColumn>
                                <GridColumn TItem="Departmentdata" HeaderText="Action" Filterable="false">
                                    <button class="btn btn-sm btn-primary me-1" @onclick="@(() => EditDepartment(context.Id))">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="@(() => AskDelete(context.Id))">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </GridColumn>
                            </GridColumns>
                        </Grid>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Bootstrap Modal -->
    <div class="modal fade" id="departmentModal" tabindex="-1" aria-labelledby="departmentModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="newDepartment" OnValidSubmit="SaveDepartment">
                    <FluentValidationValidator />
                    @if (!string.IsNullOrEmpty(ModalMessage))
                    {
                        <div class="alert @ModalCssClass" role="alert">
                            @ModalMessage
                        </div>
                    }
                    <div class="modal-header">
                        <h5 class="modal-title" id="departmentModalLabel">Add Department</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <!-- Department Name -->
                        <div class="form-group">
                            <label>Department Name</label>
                            <InputText class="form-control mb-2"
                                       placeholder="Department Name"
                                       @bind-Value="newDepartment.DepartmentName" />
                            <ValidationMessage For="@(() => newDepartment.DepartmentName)" />
                        </div>

                        <!-- Is Active -->
                        <div class="form-group">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="newDepartment.Isactive" id="IsActive" />
                                <label class="form-check-label" for="IsActive">Is Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</section>
@* <ConfirmationModal Show="@ShowConfirmDialog"
               Title="Delete Department"
               Message="Are you sure you want to delete this department?"
               ConfirmationChanged="OnDeleteConfirmation" /> *@

<ConfirmDialog @ref="confirmDialog" />

@code {
    private List<Departmentdata> departmentlist = new List<Departmentdata>();
    private Mst_Department newDepartment = new() { Isactive = false };
    private EditContext? editContext;
    private string? ModalMessage { get; set; }
    private string ModalCssClass { get; set; } = "alert-info";
    //private bool ShowConfirmDialog { get; set; }
    //private int DeleteDeptId { get; set; }
    private ConfirmDialog confirmDialog;

    private bool IsGridLoading = true;
    private int PageSize { get; set; } = 10;
    private List<int> PageSizes = new() { 5, 10, 25, 50, 100 };
    private string GlobalSearch { get; set; } = string.Empty;

    private IEnumerable<Departmentdata> FilteredDepartment => string.IsNullOrWhiteSpace(GlobalSearch)
        ? departmentlist
        : departmentlist.Where(m =>
            (m.DepartmentName ?? "").Contains(GlobalSearch, StringComparison.OrdinalIgnoreCase) ||
            (m.ParentDepartmentName ?? "").Contains(GlobalSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private async Task ShowModalMessage(string message, string type)
    {
        ModalMessage = message;
        ModalCssClass = type switch
        {
            "success" => "alert alert-success",
            "warning" => "alert alert-warning",
            "error" => "alert alert-danger",
            _ => "alert alert-info"
        };

        StateHasChanged();

        // wait 2 seconds
        await Task.Delay(3000);

        if (type == "success")
        {
            // Close modal
            //await ModalService.HideAsync("departmentModal");
            await JS.InvokeVoidAsync("bootstrapModalHelper.hide", "departmentModal");
            ResetForm();
        }

        // clear message after fade out
        ModalMessage = string.Empty;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        await LoadDepartment();

    }

    private async Task LoadDepartment()
    {
        try
        {
            IsGridLoading = true;
            using var Db = DbFactory.CreateDbContext();
            departmentlist = await (from d1 in Db.Mst_Department
                                    join d2 in Db.Mst_Department on d1.ParentDepartmentId equals d2.Id into ddGroup
                                    from d2 in ddGroup.DefaultIfEmpty()
                                    where d1.DeletedBy == null
                                    select new Departmentdata
                                    {
                                        Id = d1.Id,
                                        DepartmentName = d1.DepartmentName,
                                        Isactive = d1.Isactive,
                                        IsSubDepartment = d1.IsSubDepartment,
                                        ParentDepartmentId = d1.ParentDepartmentId,
                                        ParentDepartmentName = d2.DepartmentName,
                                    }).ToListAsync();
        }
        catch (Exception ex)
        {
            _helper.SaveException(ex, "Department/LoadDepartment");
            ToastService.Show("Error loading Department List: " + ex.Message, ToastType.Danger, "Error");
        }
        finally
        {
            IsGridLoading = false;
        }

    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size))
        {
            PageSize = size;
            await JS.InvokeVoidAsync("fadeGridRows");
        }
    }

    private async Task ClearSearch()
    {
        GlobalSearch = string.Empty;
        await JS.InvokeVoidAsync("fadeGridRows");
    }

    private async Task AskDelete(int id)
    {
        //DeleteDeptId = id;
        //ShowConfirmDialog = true;
        var options = new ConfirmDialogOptions { IsVerticallyCentered = true };
        bool confirmed = await confirmDialog!.ShowAsync(
            "Delete Department", "Are you sure you want to delete this department?", options
        );
        if (confirmed)
        {
            await DeleteDepartment(id);
        }
        //await OnDeleteConfirmation(confirmed);
    }

    //private async Task OnDeleteConfirmation(bool confirmed)
    //{
    //    //ShowConfirmDialog = false;
    //    if (confirmed)
    //    {
    //        
    //    }
    //}

    private async Task OpenAddModal()
    {
        ResetForm();
        //await ModalService.ShowAsync("departmentModal");
        await JS.InvokeVoidAsync("bootstrapModalHelper.show", "departmentModal");
    }

    private void ResetForm()
    {
        newDepartment = new Mst_Department();
        editContext = new EditContext(newDepartment);
    }

    private async Task EditDepartment(int Id)
    {
        using var Db = DbFactory.CreateDbContext();
        var department = Db.Mst_Department.Where(d => d.DeletedBy == null && d.Id == Id).FirstOrDefault();
        if (department == null || department.Id == 0)
        {
            ToastService.Show("No Department found!", ToastType.Warning, "Warning");
            await LoadDepartment();
        }
        else
        {
            newDepartment = department;
            //await ModalService.ShowAsync("departmentModal");
            await JS.InvokeVoidAsync("bootstrapModalHelper.show", "departmentModal");
        }
    }

    private async Task SaveDepartment()
    {
        using var Db = DbFactory.CreateDbContext();
        var checkdept = Db.Mst_Department.Where(d => d.DeletedBy == null && d.DepartmentName == newDepartment.DepartmentName && d.Id != newDepartment.Id).FirstOrDefault();
        if (newDepartment.Id == 0)
        {
            if (checkdept != null)
            {
                await ShowModalMessage("Department already exists!", "error");
                return;
            }

            var entity = new Mst_Department
            {
                DepartmentName = newDepartment.DepartmentName,
                Isactive = newDepartment.Isactive,
                CreatedBy = 1,
                CreatedOn = DateTime.Now
            };

            Db.Mst_Department.Add(entity);
            await Db.SaveChangesAsync();
            await LoadDepartment();
            await ShowModalMessage("Department saved successfully!", "success");
        }
        else
        {
            if (checkdept != null)
            {
                await ShowModalMessage("Department already exists!", "warning");
                return;
            }
            var existDept = Db.Mst_Department.Where(d => d.DeletedBy == null && d.Id == newDepartment.Id).FirstOrDefault();
            existDept.DepartmentName = newDepartment.DepartmentName;
            existDept.Isactive = newDepartment.Isactive;
            existDept.UpdatedBy = 1;
            existDept.UpdatedOn = DateTime.Now;
            await ShowModalMessage("Department updated successfully!", "success");
        }

    }

    private async Task DeleteDepartment(int Id)
    {
        using var Db = DbFactory.CreateDbContext();
        var department = await Db.Mst_Department.Where(d => d.DeletedBy == null && d.Id == Id).FirstOrDefaultAsync();
        if (department == null) { ToastService.Show("No Department found!", ToastType.Warning, "Warning"); await LoadDepartment(); return; }

        department.DeletedBy = 1;
        department.DeletedOn = DateTime.Now;
        await Db.SaveChangesAsync();
        ToastService.Show("Department Deleted successfully!", ToastType.Success, "Success");
        await LoadDepartment();
    }


    public class Departmentdata
    {
        public int Id { get; set; }
        public string? DepartmentName { get; set; }
        public bool? Isactive { get; set; }
        public bool? IsSubDepartment { get; set; }
        public int? ParentDepartmentId { get; set; }
        public string? ParentDepartmentName { get; set; }
    }

}
