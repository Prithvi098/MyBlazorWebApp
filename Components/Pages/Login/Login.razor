@page "/"
@using static MyBlazorApp.Models.LoginModel
@layout LoginLayout
@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="row g-4 justify-content-center auth-login-grid">
    @* <div class="col-12 col-lg-5">
        <div class="auth-story-panel">
            <div class="brand-logo">
                <img src="/Logo.png" alt="logo" class="img-fluid" />
            </div>
            <span class="auth-kicker">Employee Management System</span>
            <h1>Run attendance, people records, and admin workflows from one polished workspace.</h1>
            <p>Sign in to continue to your dashboard, manage teams, and keep day-to-day operations moving.</p>

            <div class="auth-feature-list">
                <div class="auth-feature-item">
                    <RadzenIcon Icon="grid_view" />
                    <span>Streamlined dashboards for daily actions</span>
                </div>
                <div class="auth-feature-item">
                    <RadzenIcon Icon="group" />
                    <span>Cleaner employee and permissions management</span>
                </div>
                <div class="auth-feature-item">
                    <RadzenIcon Icon="schedule" />
                    <span>Quick punch tracking with a calmer layout</span>
                </div>
            </div>
        </div>
    </div> *@

    <div class="col-12 col-md-10 col-lg-6 col-xl-5 d-flex align-items-center justify-content-center">
        <RadzenCard class="auth-card login-box">
            <div class="auth-card-header">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Welcome back</RadzenText>
                <p>Use your account credentials to start your session.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="app-inline-alert app-inline-alert--danger">@errorMessage</div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="SubmitForm" class="auth-form">
                <DataAnnotationsValidator />

                <div class="form-group mb-3">
                    <label class="form-label required">Username</label>
                    <div class="input-group app-input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <InputText @bind-Value="loginModel.Username" class="form-control" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Username)" />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label required">Password</label>
                    <div class="app-password-wrap">
                        <PasswordInput @bind-Value="loginModel.Password" Type="password" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <div class="auth-actions">
                    <RadzenButton Text="Login"
                                  
                                  ButtonType="Radzen.ButtonType.Submit"
                                  class="auth-action-button" />
                    <RadzenButton Text="Register"
                                  Icon=""
                                  Variant="Variant.Outlined"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Click="@NavigateToRegister"
                                  class="auth-action-button auth-action-button--secondary" />
                </div>
            </EditForm>
        </RadzenCard>
    </div>
</div>

@code {

    private LoginModel.LoginRequest loginModel = new();
    private string errorMessage = "";

    private DotNetObjectReference<Login>? dotnetRef;

    protected override void OnInitialized()
    {
        dotnetRef = DotNetObjectReference.Create(this);
    }

    private async Task SubmitForm()
    {
        errorMessage = "";

        await JS.InvokeVoidAsync(
            "submitLoginForm",
            loginModel,
            dotnetRef
        );
    }

    [JSInvokable]
    public void SetLoginError(string message)
    {
        errorMessage = message;
        StateHasChanged();
    }

    private void NavigateToRegister()
    {
        Navigation.NavigateTo("/register");
    }

    public void Dispose()
    {
        dotnetRef?.Dispose();
    }
}
