@rendermode InteractiveServer

@if (PunchList is null || PunchList.Count == 0)
{
    <div class="empty-state mt-3">
        <RadzenIcon Icon="event_busy" />
        <span>No punch data available for today.</span>
    </div>
}
else
{
    <div class="punch-timeline">
        @foreach (var item in PunchList)
        {
            <div class="punch-timeline-item">
                @if (item.PunchIn.HasValue)
                {
                    <div class="punch-time-chip">
                        <RadzenIcon />
                        <span>IN TIME</span>
                        <strong>@item.PunchIn.Value.ToString("HH:mm:ss")</strong>
                    </div>
                }

                @if (item.PunchOut.HasValue)
                {
                    <div class="punch-time-chip">
                        <RadzenIcon />
                        <span>OUT TIME</span>
                        <strong>@item.PunchOut.Value.ToString("HH:mm:ss")</strong>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<EmployeePunchDetail>? PunchList { get; set; }
}
