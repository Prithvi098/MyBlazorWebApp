@rendermode InteractiveServer

@if (PunchList is null || PunchList.Count == 0)
{
    <p>No punch data available.</p>
}
else
{
    foreach (var item in PunchList)
    {
        <div class="mb-2">
            @if (item.PunchIn.HasValue)
            {
                <span style="font-size:large;">
                    <label style="color:blue">IN TIME :</label>
                    @(item.PunchIn.Value.ToString("HH") + ":" + item.PunchIn.Value.ToString("mm") + ":" + item.PunchIn.Value.ToString("ss"))
                </span>
            }

            @if (item.PunchOut.HasValue)
            {
                <span style="font-size:large; margin-left:20px;">
                    <label style="color:blue">OUT TIME :</label>
                    @(item.PunchOut.Value.ToString("HH") + ":" + item.PunchOut.Value.ToString("mm") + ":" + item.PunchOut.Value.ToString("ss"))
                </span>
            }
        </div>
    }
}

@code {
    [Parameter] public List<EmployeePunchDetail>? PunchList { get; set; }
}