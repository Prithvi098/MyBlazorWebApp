@page "/home"
@using Microsoft.AspNetCore.Authentication.Cookies
@attribute [Authorize]
@layout MainLayout
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@inject IDbContextFactory<EMSContext> DbFactory
@inject AppToastService ToastService
@inject AuthenticationStateProvider Auth
@inject PunchService PunchService
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<section class="content page-section">
    <div class="container-fluid p-0">
        <div class="content-header">
            <div class="container-fluid p-0">
                <div class="main-title">
                    <h3 class="m-0">Dashboard</h3>
                </div>
            </div>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-12 col-lg-4">
                <RadzenCard class="dashboard-stat-card small-box bg-teal h-100">
                    <div class="inner">
                        <div class="d-flex align-items-start justify-content-between gap-3">
                            <div>
                                <p class="text-uppercase mb-2">Leave Applied</p>
                                <h3>@LeaveAppliedCount</h3>
                            </div>
                            <RadzenIcon class="dashboard-card-icon" />
                        </div>
                    </div>
                </RadzenCard>
            </div>

            <div class="col-12 col-lg-8">
                <RadzenCard class="dashboard-panel-card h-100">
                    <div class="text-center">
                        <span class="text-uppercase d-inline-block mb-2">Live attendance clock</span>
                        <div class="digital-clock">@CurrentTime</div>
                        <div class="mt-3 mb-4">
                            <RadzenButton Text="@ButtonText"
                                          
                                          Size="Radzen.ButtonSize.Large"
                                          Disabled="@IsBusy"
                                          Click="@Punching"
                                          class="dashboard-punch-button" />
                        </div>
                    </div>

                    <PunchDataList PunchList="PunchList" />
                </RadzenCard>
            </div>
        </div>
    </div>
</section>


@code {
    List<ToastMessage> messages = new List<ToastMessage>();
    private int LeaveAppliedCount { get; set; } = 0;
    private int EmpId;
    private List<EmployeePunchDetail> PunchList = new();
    private bool IsBusy = false;

    private string INOUTSTATUS => PunchList.Any(p => p.PunchIn.HasValue && !p.PunchOut.HasValue) ? "IN" : "OUT";
    private string ButtonText => INOUTSTATUS == "OUT" ? "PUNCH IN" : "PUNCH OUT";

    private string CurrentTime => DateTime.UtcNow.AddHours(5).AddMinutes(30).ToString("HH:mm:ss");
    //private string CurrentTime => DateTime.UtcNow.AddHours(5).AddMinutes(30).ToString("HH") + ":" + DateTime.UtcNow.AddHours(5).AddMinutes(30).ToString("mm") + ":" + DateTime.UtcNow.AddHours(5).AddMinutes(30).ToString("ss");


    protected override async Task OnInitializedAsync()
    {
        using var dbContext = await DbFactory.CreateDbContextAsync();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var EmpId = 0;
        if (user.Identity?.IsAuthenticated == true)
        {
            var empIdClaim = user.FindFirst("EmpId")?.Value;

            if (int.TryParse(empIdClaim, out int empId))
            {
                EmpId = empId;
            }
        }

        DateTime currentDate = DateTime.Now;
        DateTime startFinancialYear = currentDate.Month < 4 ? new DateTime(currentDate.Year - 1, 4, 1) : new DateTime(currentDate.Year, 4, 1);
        DateTime endFinancialYear = currentDate.Month < 4 ? new DateTime(currentDate.Year, 3, 31) : new DateTime(currentDate.Year + 1, 3, 31);
        LeaveAppliedCount = dbContext.Mst_Leave_Apllications.Where(l => l.EmpId == EmpId && l.DeletedBy == null && l.Leave_Status != "Rejected" && l.Leave_Status != "Canceled" && l.LeaveStartDate >= startFinancialYear && l.LeaveStartDate <= endFinancialYear).Count();

        await LoadUserId();
        await LoadPunchList();

        // Auto-refresh clock
        var timer = new System.Timers.Timer(1000);
        timer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        timer.Start();
    }

    private async Task LoadUserId()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var empIdClaim = state.User.FindFirst("EmpId");
        EmpId = empIdClaim != null ? int.Parse(empIdClaim.Value) : 0;
    }

    private async Task LoadPunchList()
    {
        PunchList = await PunchService.GetTodayPunches(EmpId);
    }

    private async Task Punching()
    {
        IsBusy = true;

        if (INOUTSTATUS == "OUT")
        {
            var result = await PunchService.PunchIn(EmpId);
            //if (result.success)
            //    ToastService.Show("Punched In Successfully", ToastType.Success);
        }
        else
        {
            var result = await PunchService.PunchOut(EmpId);
            //if (result.success)
            //    ToastService.Show("Punched Out Successfully", ToastType.Warning);
        }

        await LoadPunchList();
        IsBusy = false;
    }


    private ToastMessage CreateToastMessage(ToastType toastType)
    => new ToastMessage
    {
        Type = toastType,
        Title = "Blazor Bootstrap",
        HelpText = $"{DateTime.Now}",
        Message = $"Hello, world! This is a toast message. DateTime: {DateTime.Now}",
    };


    void ShowSuccess()
    {
        ToastService.Show("Data saved successfully 🎉", ToastType.Success, "Data Saved");
    }

    void ShowWarning()
    {
        ToastService.Show("This action might have consequences.", ToastType.Warning, "Warning");
    }
    
    void ShowError()
    {
        ToastService.Show("Something went wrong!", ToastType.Danger, "Error");
    }
}
