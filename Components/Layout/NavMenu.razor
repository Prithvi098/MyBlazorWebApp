<nav class="main-header navbar navbar-expand-lg navbar-light border-0 app-navbar">
    <div class="container-fluid">
        <a href="/home" class="navbar-brand app-brand">
            <span class="brand-mark">
                <img src="/Logo.png" alt="Main Logo" class="img-fluid" />
            </span>
            <span class="brand-copy">
                <strong>EMS</strong>
                <small>Operations workspace</small>
            </span>
        </a>

        <button class="navbar-toggler order-1 app-navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse order-3" id="navbarCollapse">
            <ul class="navbar-nav app-navbar-links">
                @foreach (var main in Menus)
                {
                    if (!main.IsHidden)
                    {
                        <li class="nav-item dropdown">
                            <a href="@main.MenuUrl" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                @main.MenuName
                            </a>

                            @if (main.SubMenus?.Any() == true)
                            {
                                <ul class="dropdown-menu border-0 shadow app-dropdown-menu">
                                    @foreach (var sub in main.SubMenus)
                                    {
                                        if (sub.SubMenus?.Any() == true)
                                        {
                                            <li class="dropdown-submenu dropdown-hover">
                                                <a href="@sub.MenuUrl" class="dropdown-item dropdown-toggle" data-bs-toggle="dropdown">@sub.MenuName</a>
                                                <ul class="dropdown-menu border-0 shadow app-dropdown-menu">
                                                    @foreach (var child in sub.SubMenus)
                                                    {
                                                        if (!child.IsHidden)
                                                        {
                                                            <li><a href="@child.MenuUrl" class="dropdown-item">@child.MenuName</a></li>
                                                        }
                                                    }
                                                </ul>
                                            </li>
                                        }
                                        else
                                        {
                                            if (!sub.IsHidden)
                                            {
                                                <li><a href="@sub.MenuUrl" class="dropdown-item">@sub.MenuName</a></li>
                                            }
                                        }
                                    }
                                </ul>
                            }
                        </li>
                    }
                }
            </ul>

            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item app-user-summary">
                    <span class="app-user-avatar">@UserInitials</span>
                    <div class="app-user-meta">
                        <span class="app-user-label">Signed in as</span>
                        <strong>@UserFullName</strong>
                    </div>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle app-user-menu-trigger" href="#" data-bs-toggle="dropdown">
                        Account
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end app-dropdown-menu">
                        <li><a class="dropdown-item" href="/api/login/userlogout">Sign out</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

@code {
    private List<MenuModel> Menus = new();
    private string UserFullName = "User";
    private string UserInitials => string.Join("", UserFullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Get EmpId claim (ensure this claim is added when logging in)
            var empIdClaim = user.FindFirst("EmpId")?.Value;

            if (int.TryParse(empIdClaim, out int empId))
            {
                // ✅ Use EmpId in your MenuService
                Menus = MenuService.GetUserMenus(empId, 1);
            }

            // Example: get full name claim or use fallback
            UserFullName = user.FindFirst("FullName")?.Value ?? user.Identity?.Name ?? "User";
        }
        else
        {
            // Not logged in
            UserFullName = "Guest";
            Menus = new List<MenuModel>();
        }

    }
}
