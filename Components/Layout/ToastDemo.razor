@page "/toast-demo"
@using BlazorBootstrap
@rendermode InteractiveServer

<h3>Toast Demo</h3>

@* <Toasts class="p-3"
        Messages="messages"
        Delay="5000" 
        Autohide="true"
        Placement="ToastsPlacement.TopRight" /> *@

<Button Color="ButtonColor.Success"
        @onclick="() => ShowToast()">
    Success Toast
</Button>



@code {
    List<ToastMessage> messages = new();

    void ShowToast()
    {
        messages.Add(new ToastMessage
        {
            Type = ToastType.Warning,
            Title = "Success",
            Message = "It finally works 🎉"
        });
    }
}