@page "/notauthorized"

<div class="not-auth-container">
    <div class="not-auth-card">
        <h2>🚫 Access Denied</h2>
        <p>You do not have permission to access this page.</p>
        <a class="btn btn-primary mt-3" href="/home">Go Back Home</a>
    </div>
</div>

<style>
    .not-auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 70vh;
        animation: fadeIn 0.5s ease-in-out;
    }

    .not-auth-card {
        background: white;
        padding: 40px 50px;
        border-radius: 12px;
        box-shadow: 0px 5px 25px rgba(0,0,0,0.15);
        text-align: center;
        max-width: 460px;
    }

    h2 {
        margin-bottom: 15px;
        font-weight: 800;
        color: #dc3545;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

